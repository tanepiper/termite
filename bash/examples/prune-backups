#!/usr/bin/env bash
# --- termite preamble 1: checks bash, then loads the termite library ---
if [ -z "${BASH_VERSINFO-}" ] || [ "${BASH_VERSINFO[0]}" -lt 5 ] ||
  { [ "${BASH_VERSINFO[0]}" -eq 5 ] && [ "${BASH_VERSINFO[1]}" -lt 3 ]; }; then
  if [ "$(uname -s)" = Darwin ]; then
    _termite_fix='brew install bash'
  else
    _termite_fix='install bash 5.3 or later with your package manager'
  fi
  printf '%s needs bash 5.3 or later; this is %s (%s).\nFix: %s\n' \
    "${0##*/}" "${BASH_VERSION:-not bash}" "${BASH:-sh}" "$_termite_fix" >&2
  exit 1
fi
_termite_load() {
  local home=${TERMITE_HOME:-$HOME/.config/termite} path problem version
  local lib=$home/lib/termite
  if [[ $home != /* ]]; then
    printf '%s: TERMITE_HOME must be an absolute path, not %s\n' \
      "${0##*/}" "$home" >&2
    exit 1
  fi
  for path in "$home" "$home/lib" "$lib" "$lib/VERSION" "$lib/core.sh" "$lib"/*.sh; do
    if [[ -L $path ]]; then
      problem='a symlink'
    elif [[ ! -e $path ]]; then
      problem='missing'
    elif [[ ! -O $path ]]; then
      problem='not owned by you'
    elif [[ -n $(find "$path" -prune \( -perm -020 -o -perm -002 \) -print) ]]; then
      problem='writable by other users'
    else
      continue
    fi
    printf '%s: cannot load the termite library: %s is %s.\nFix: run tmite setup\n' \
      "${0##*/}" "$path" "$problem" >&2
    exit 1
  done
  IFS= read -r version <"$lib/VERSION" || version=
  if [[ ! $version =~ ^[0-9]+$ ]] || ((version < 1)); then
    printf '%s: the termite library is version %s; this script needs 1 or later.\nFix: run tmite setup\n' \
      "${0##*/}" "${version:-unknown}" >&2
    exit 1
  fi
}
_termite_load
unset -f _termite_load
# shellcheck source=lib/termite/core.sh
source "${TERMITE_HOME:-$HOME/.config/termite}/lib/termite/core.sh"
# --- end of termite preamble ---


usage() {
  cat <<'HELP'
prune-backups: delete old files from a backup folder.

Usage: prune-backups [options] FOLDER

Deletes the files directly inside FOLDER that match --pattern and were
last changed more than --days days ago. Asks before deleting.

Options:
  -d, --days N        keep files changed in the last N days (default 7)
  -p, --pattern GLOB  only files whose name matches GLOB (default *)
  -n, --dry-run       list what would be deleted, delete nothing
  -y, --yes           do not ask before deleting
  -v, --verbose       list each file as it is deleted
  -q, --quiet         only warnings and errors
  -h, --help          show this help
      --version       show the version

Examples:
  prune-backups --dry-run ~/backups/notes
  prune-backups --days 30 --pattern '*.tar.gz' ~/backups/notes

Exit status: 0 done (or nothing to do), 1 failed, 64 bad usage.
HELP
}

main() {
  args_version 1.0.0
  args_value days d 7
  args_value pattern p '*'
  args_flag dry-run n
  args_parse "$@"

  ((${#ARGS_REST[@]} == 1)) || args_error "give exactly one FOLDER"
  local folder=${ARGS_REST[0]} days=${ARGS[days]} pattern=${ARGS[pattern]}
  [[ $days =~ ^[0-9]{1,5}$ ]] || args_error "--days must be a whole number"
  [[ -n $pattern && $pattern != */* ]] || args_error "--pattern must be a file name pattern"
  [[ -d $folder && ! -L $folder ]] || die "$(log_printable "$folder") is not a folder"
  [[ $(cd -- "$folder" && pwd -P) != / ]] || die "refusing to prune /"
  require_cmd find rm

  local -a files=()
  local file
  while IFS= read -r -d '' file; do
    files+=("$file")
  done < <(find "$folder" -mindepth 1 -maxdepth 1 -type f \
    -name "$pattern" -mtime "+$days" -print0)

  if ((${#files[@]} == 0)); then
    log_info "nothing older than $days days in $folder"
    return 0
  fi

  if args_on dry-run; then
    log_info "would delete ${#files[@]} files:"
    for file in "${files[@]}"; do
      printf '%s\n' "$(log_printable "$file")"
    done
    return 0
  fi

  if ! confirm "Delete ${#files[@]} files older than $days days from $folder?"; then
    log_info "nothing deleted"
    return 0
  fi

  for file in "${files[@]}"; do
    log_verbose "deleting $file"
    rm -f -- "$file"
  done
  log_info "deleted ${#files[@]} files"
}

main "$@"
