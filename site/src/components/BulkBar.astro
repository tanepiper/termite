---
/** Commands from public datasets sent through the policy, with no model involved. */
import { results } from "../lib/results";
import Explain from "./Explain.astro";

const { total, allowed, hazardous, allowed_hazardous: flagged, refused_plain: plain } = results.bulk;
const parts = [
  { count: flagged, tone: "bad", name: "Allowed, and on the hazard list", text: "Each one is a possible policy bypass to check. The commands stay private." },
  { count: allowed - flagged, tone: "plain", name: "Allowed, nothing flagged", text: "These commands only read." },
  { count: hazardous - flagged, tone: "held", name: "Blocked, and on the hazard list", text: "The policy blocked these hazards." },
  { count: plain, tone: "over", name: "Blocked, nothing flagged", text: "These may be harmless. The policy blocks anything that it cannot prove only reads." },
];
const number = (value: number) => value.toLocaleString("en-GB");
/** One decimal place, or more when that would round a real count down to nothing. */
const percent = (count: number) => {
  const share = (100 * count) / total;
  return `${share > 0 && share < 0.1 ? share.toPrecision(1) : share.toFixed(1)}%`;
};
---

<Explain summary="How to read this chart" terms={[
  ["Bar", "All the commands in this test. Each colour is one group, and a wider part means more commands."],
  ["Large number", "How many commands are in that group."],
  ["Percentage", "That group's share of all the commands."],
  ["Red", "The group to check first: the policy allowed these commands, and they are on the hazard list."],
]} />
<figure>
  <div class="bar" role="img" aria-label={parts.map((part) => `${number(part.count)} ${part.name}`).join(", ")}>
    {parts.map((part) => <i class={part.tone} style={`flex-grow:${part.count}`} title={`${part.name}: ${number(part.count)}`}></i>)}
  </div>
  <dl>
    {parts.map((part) => (
      <div>
        <dt class={part.tone}>{number(part.count)}<small>{percent(part.count)}</small></dt>
        <dd><b>{part.name}.</b> {part.text}</dd>
      </div>
    ))}
  </dl>
</figure>

<style>
  figure { margin: 1.2em 0; }
  .bar { display: flex; gap: 2px; height: 22px; }
  .bar i { display: block; min-width: 3px; }
  i.bad { background: var(--fail-2); }
  i.held { background: var(--gallery); }
  i.plain { background: var(--ink-soft); }
  i.over { background: var(--line); }
  dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13em), 1fr)); gap: 1em 2em; margin: 1em 0 0; }
  dt { font: 700 1.9rem/1.1 var(--serif); font-feature-settings: "ss01"; }
  dt.bad { color: var(--critical); }
  dt small { font: 400 0.85rem var(--sans); color: var(--ink-soft); margin-left: 0.5em; }
  dd { margin: 0.2em 0 0; font-size: 0.9rem; color: var(--ink-soft); }
  dd b { color: var(--ink); font-weight: 500; }
</style>
