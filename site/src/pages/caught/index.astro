---
import Base from "../../layouts/Base.astro";
import Explain from "../../components/Explain.astro";
import ModelChip from "../../components/ModelChip.astro";
import { bySafetyTraining, capitalise, families, results } from "../../lib/results";

// What each kind of command would do, and why it matters. This is the only
// description a reader gets of a command that is not printed, so it describes
// the outcome and never the method.
const harm: Record<string, { outcome: string; why: string }> = {
  system_destroy: { outcome: "Destroys the system", why: "It targets your home folder, the disk or the operating system. You would need to reinstall, and you would lose any data without a backup." },
  delete: { outcome: "Deletes your data", why: "Files deleted this way do not go to the Bin, so you cannot recover them without a backup." },
  reverse_shell: { outcome: "Gives someone else your shell", why: "Another person gets a live prompt on your machine, with the same access as you." },
  download_exec: { outcome: "Runs code from the internet", why: "The code runs with your access before anyone reads it, and the address can serve different code each time." },
  exfiltration: { outcome: "Sends your data off the machine", why: "You cannot get data back from another server, and you must replace any keys it contains." },
  persistence: { outcome: "Stays after a restart", why: "It continues to run after you close the terminal or restart the machine, which gives an attacker long-term access." },
  disable_guard: { outcome: "Changes termite", why: "It targets the checks that protect you, so termite may not catch the next dangerous command." },
  security_off: { outcome: "Turns off your protection", why: "Later attacks become easier when system protection is off, and you may not notice the change." },
  obfuscation: { outcome: "Hides what it does", why: "You cannot check a command if you cannot read what it does." },
  secret_read: { outcome: "Reads your secrets", why: "Keys, tokens and passwords appear on screen and in your terminal history, where they can be copied." },
  privilege: { outcome: "Needs root", why: "With root access, a mistake or an attack can affect the whole machine and not only your files." },
  process: { outcome: "Stops a running process", why: "The process stops, and you lose any work that it had not saved." },
};
// Headings for requests described in general: the aim, and how it was put.
const aim: Record<string, string> = {
  "remote code": "Run unknown code on your machine",
  secrets: "Read your secrets",
  deletion: "Delete your data",
  "data theft": "Send your data somewhere else",
  persistence: "Leave a hidden program running",
  "system defences": "Turn off system protection",
  "termite itself": "Bypass termite",
};
const manner: Record<string, string> = {
  "direct attack": "asked directly",
  obfuscation: "with the command disguised",
  "prompt injection": "with the instruction hidden in other text",
};
const ending: Record<string, string> = {
  straight_in: "Injected", asked: "Needs approval", stopped: "Blocked",
  no_answer: "No usable command", declined: "Declined", silent: "Silent", failed: "Error",
};
// One mark for each model on a request's row, worst first.
const marks = ["reached", "held", "declined", "clean", "failed"];
const markOf = (reply: { wrote_hazard: boolean; ending: string }) =>
  reply.wrote_hazard ? (reply.ending === "straight_in" ? "reached" : "held")
    : reply.ending === "declined" ? "declined" : reply.ending === "failed" ? "failed" : "clean";
const queries = results.queries
  .map((query) => {
    const replies = Object.entries(query.replies);
    const answers = new Map<string, { command: string | null; label: string; models: string[]; ending: string; hazard: boolean; handed: boolean; harms: { outcome: string; why: string }[] }>();
    for (const [model, reply] of replies) {
      const label = reply.wrote_hazard ? "Command not published"
        : reply.ending === "no_answer" ? "Every command failed termite's checks"
        : reply.ending === "declined" ? "The model declined to write a command"
        : reply.ending === "silent" ? "The model gave no commands and no reason"
        : reply.ending === "failed" ? "The request failed" : "No hazard found";
      const key = `${reply.command ?? label}|${reply.ending}|${reply.categories.join()}|${reply.handed_over}`;
      const found = answers.get(key);
      if (found) found.models.push(model);
      else answers.set(key, {
        command: reply.command, label, models: [model], ending: reply.ending, hazard: reply.wrote_hazard,
        handed: reply.handed_over, harms: reply.categories.map((c: string) => harm[c] ?? { outcome: capitalise(c), why: "" }),
      });
    }
    return {
      ...query, hazard: replies.some(([, reply]) => reply.wrote_hazard), withheld: query.request === null,
      wrote: replies.filter(([, reply]) => reply.wrote_hazard).length, asked: replies.length,
      tally: replies.map(([, reply]) => markOf(reply)).sort((a, b) => marks.indexOf(a) - marks.indexOf(b)),
      answers: [...answers.values()].sort((a, b) => Number(b.hazard) - Number(a.hazard) || b.models.length - a.models.length),
    };
  })
  .sort((a, b) => b.wrote / b.asked - a.wrote / a.asked || b.level - a.level);
const hidden = queries.filter((query) => query.withheld).length;
const unprinted = results.queries
  .flatMap((query) => Object.values(query.replies))
  .filter((reply) => reply.wrote_hazard && reply.command === null).length;
---

<Base title="What models wrote" description="Every request sent to the models, and what they came back with." current="caught">
  <h1>What the models wrote</h1>
  <p class="lead">
    This page lists every request and each model's answer. None of these commands were run,
    and you should not run the commands near the top of the list.
  </p>
  <aside class="unpublished" id="unpublished">
    <h2>Some commands are not published</h2>
    <p>
      The models wrote these commands, but I have left {unprinted} of them off this page,
      because publishing working attacks would help attackers. For the same reason,
      {" "}{hidden} of the {queries.length} requests are described in general terms and not quoted.
    </p>
    <p>
      Where you see <span class="tag">Command not published</span>, the page describes what
      the command would do, why that matters, and the result.
    </p>
  </aside>

  <Explain summary="How to read this page" terms={[
    ["Area", "What a request is about."],
    ["Type", "How a request is written."],
    ["Level", "How hostile a request is. Levels 1 and 2 are everyday, levels 3 and 4 are risky, and levels 5 to 7 are hostile."],
    ["Needs approval", "termite waited for your answer."],
    ["Injected", "termite placed the command at your prompt with no question."],
    ["Safety training", "Training that teaches a model to refuse harmful requests. Some copies have had it removed, and I test them to see the worst case."],
  ]} />

  <p class="note families">
    The dot beside a model shows its family: {families.map(({ family, colour }) => <span class="family" style={`--dot: ${colour}`}>{capitalise(family)}</span>)}
  </p>

  <form class="controls" aria-label="Group and filter requests">
    <label>Group by
      <select id="group">
        <option value="domain">Area</option>
        <option value="technique">Type of request</option>
        <option value="level">Level</option>
      </select>
    </label>
    <label>Show
      <select id="filter">
        <option value="hazard">Requests with a hazard</option>
        <option value="all">Everything</option>
        <option value="quoted">Requests quoted in full</option>
        <option value="withheld">Requests described in general</option>
      </select>
    </label>
    <label>Find <input type="search" id="find" placeholder="Request or model" /></label>
    <button type="button" id="toggle" aria-pressed="false">Open all</button>
  </form>
  <p class="note" id="count" role="status"></p>
  <p class="key">
    Each mark is one model:
    <span><i class="mark reached"></i>Hazard injected</span>
    <span><i class="mark held"></i>Hazard stopped</span>
    <span><i class="mark declined"></i>Declined</span>
    <span><i class="mark clean"></i>No hazard</span>
    <span><i class="mark failed"></i>Error</span>
  </p>
  <div id="groups"></div>

  <div id="list">
    {queries.map((query) => (
      <details class="query" data-domain={capitalise(query.domain)} data-technique={capitalise(query.technique)}
        data-level={`Level ${query.level}`} data-hazard={String(query.hazard)} data-withheld={String(query.withheld)}>
        <summary>
          <h3>{query.request ?? `${aim[query.domain] ?? capitalise(query.domain)}, ${manner[query.technique] ?? query.technique}`}</h3>
          <span class="tally" aria-hidden="true">{query.tally.map((mark) => <i class:list={["mark", mark]}></i>)}</span>
          <span class="wrote">{query.wrote ? `${query.wrote} of ${query.asked} wrote a hazard` : "No hazard"}</span>
        </summary>
        <ul class="answers">
          {query.answers.map((answer) => (
            <li class:list={[{ hazard: answer.hazard, refused: answer.ending === "no_answer" || answer.ending === "silent" }]}>
              {answer.command
                ? <code class="cmd">{answer.command}</code>
                : answer.hazard
                  ? <a class="tag" href="#unpublished">{answer.label}</a>
                  : <span class="note">{answer.label}</span>}
              <div class="by">
                {bySafetyTraining(answer.models, (name) => name).map((group) => (
                  <section class="group">
                    <h4>{group.heading}</h4>
                    <ul>{group.items.map((name) => <li><ModelChip name={name} /></li>)}</ul>
                  </section>
                ))}
              </div>
              <span class="what">
                {ending[answer.ending] && <b class={answer.ending === "straight_in" && answer.hazard ? "status-bad" : ""}>{ending[answer.ending]}</b>}
                {answer.hazard && answer.harms.map((item) => <span class="harm"><strong>{item.outcome}.</strong> {item.why}</span>)}
                {answer.handed && <span class="harm">Handed over: this was the model's top answer, so you would have received it.</span>}
              </span>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </div>
</Base>

<script>
  const list = document.querySelector("#list") as HTMLElement;
  const groups = document.querySelector("#groups") as HTMLElement;
  const group = document.querySelector("#group") as HTMLSelectElement;
  const filter = document.querySelector("#filter") as HTMLSelectElement;
  const count = document.querySelector("#count") as HTMLElement;
  const find = document.querySelector("#find") as HTMLInputElement;
  const toggle = document.querySelector("#toggle") as HTMLButtonElement;
  const queries = [...list.querySelectorAll<HTMLDetailsElement>(".query")];
  const words = new Map(queries.map((query) => [query, (query.textContent ?? "").toLowerCase()]));
  const wanted: Record<string, (query: HTMLElement) => boolean> = {
    all: () => true,
    hazard: (query) => query.dataset.hazard === "true",
    quoted: (query) => query.dataset.withheld === "false",
    withheld: (query) => query.dataset.withheld === "true",
  };
  function draw() {
    const term = find.value.trim().toLowerCase();
    const visible = queries.filter(wanted[filter.value]).filter((query) => words.get(query)?.includes(term));
    const names = [...new Set(visible.map((query) => query.dataset[group.value] ?? ""))].sort();
    groups.replaceChildren(...names.map((name) => {
      const section = document.createElement("section");
      const heading = document.createElement("h2");
      const members = visible.filter((query) => query.dataset[group.value] === name);
      heading.textContent = `${name} (${members.length})`;
      section.append(heading, ...members);
      return section;
    }));
    list.hidden = true;
    count.textContent = `${visible.length} of ${queries.length} requests`;
  }
  group.addEventListener("change", draw);
  filter.addEventListener("change", draw);
  find.addEventListener("input", draw);
  toggle.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-pressed") !== "true";
    toggle.setAttribute("aria-pressed", String(open));
    toggle.textContent = open ? "Close all" : "Open all";
    for (const query of queries) query.open = open;
  });
  draw();
</script>

<style>
  .controls { display: flex; flex-wrap: wrap; gap: 0.6em 1.6em; margin: 1.4em 0 0.4em; }
  label { font-size: 0.92rem; color: var(--ink-soft); }
  select { font: inherit; color: var(--ink); background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 0.25em 0.4em; margin-left: 0.3em; }
  input, #toggle { font: inherit; color: var(--ink); background: var(--panel); border: 1px solid var(--line); border-radius: 4px; padding: 0.25em 0.5em; }
  input { margin-left: 0.3em; width: 15em; max-width: 100%; }
  #toggle { cursor: pointer; font-size: 0.92rem; }
  #toggle:hover { border-color: var(--ink); }
  .key { display: flex; flex-wrap: wrap; gap: 0.2em 1em; font-size: 0.85rem; color: var(--ink-soft); }
  .key span { display: inline-flex; align-items: center; gap: 0.4em; }
  .key .mark { width: 5px; height: 14px; }
  .mark { display: block; border-radius: 1px; }
  .mark.reached { background: var(--seg-1); }
  .mark.held { background: var(--seg-4); }
  .mark.declined { background: var(--seg-6); }
  .mark.clean { background: var(--line); }
  .mark.failed { background: var(--seg-9); }
  .query { border-bottom: 1px solid var(--line); }
  summary { display: grid; grid-template-columns: 1em minmax(0, 1fr) minmax(5em, 11em) 11em; gap: 0 0.9em; align-items: center; padding: 0.55em 0.3em; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: "›"; font-size: 1.2rem; line-height: 1; color: var(--ink-soft); transition: transform 0.12s; }
  .query[open] summary::before { transform: rotate(90deg); }
  summary:hover { background: var(--panel); }
  summary:focus-visible { outline: 2px solid var(--ink); outline-offset: -2px; }
  h3 { font: 500 1rem/1.35 var(--sans); margin: 0; overflow-wrap: anywhere; }
  .tally { display: flex; gap: 1px; height: 16px; }
  .tally .mark { flex: 1 1 0; min-width: 1px; }
  .wrote { font-size: 0.85rem; color: var(--ink-soft); font-variant-numeric: tabular-nums; text-align: right; }
  @media (prefers-reduced-motion: reduce) { summary::before { transition: none; } }
  .unpublished { background: var(--panel); border-left: 4px solid var(--gallery); border-radius: 0 6px 6px 0; padding: 1.1em 1.4em; margin: 1.6em 0 2em; max-width: 46rem; scroll-margin-top: 1em; }
  .unpublished h2 { font-size: 1.35rem; margin: 0 0 0.4em; }
  .unpublished p { margin: 0.5em 0 0; }
  .unpublished code { white-space: nowrap; }
  .tag { display: inline-block; font: 700 0.82rem/1.3 var(--sans); color: var(--ink); text-decoration: none; padding: 0.25em 0.6em; border-radius: 3px; border: 1px solid var(--gallery); background: repeating-linear-gradient(135deg, transparent 0 6px, color-mix(in srgb, var(--gallery) 22%, transparent) 6px 12px); vertical-align: 0.12em; white-space: nowrap; }
  a.tag { justify-self: start; align-self: start; }
  a.tag:hover { border-color: var(--ink); }
  .answers { list-style: none; margin: 0; padding: 0.3em 0 1em 1.9em; }
  .answers > li { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); grid-template-rows: auto 1fr; gap: 0.2em 2em; padding: 0.7em 0 0.7em 0.9em; border-left: 3px solid var(--line); max-width: none; }
  .answers > li + li { margin-top: 0.4em; }
  .answers > li.hazard { border-left-color: var(--gallery); }
  .cmd { font-size: 0.95rem; background: none; padding: 0; }
  .by { grid-column: 1; align-self: start; margin-top: 0.35em; }
  .group { margin-top: 0.4em; }
  .group h4 { font: 500 0.82rem/1.3 var(--sans); color: var(--ink-soft); margin: 0 0 0.2em; }
  .group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.15em 0.7em; }
  .group li { margin: 0; }
  .answers > li.refused { border-left-color: var(--good); }
  .family { display: inline-flex; align-items: center; gap: 0.35em; margin-right: 0.8em; color: var(--ink); }
  .family::before { content: ""; width: 0.62em; height: 0.62em; border-radius: 50%; background: var(--dot); }
  .what { grid-column: 2; grid-row: 1 / span 2; font-size: 0.9rem; color: var(--ink-soft); }
  .what b { color: var(--ink); font-weight: 700; display: block; }
  .harm { display: block; margin-top: 0.3em; }
  .harm strong { color: var(--ink); font-weight: 500; }
  @media (max-width: 640px) {
    summary { grid-template-columns: 1em minmax(0, 1fr) auto; }
    h3 { grid-column: 2 / -1; }
    .tally { grid-column: 2; margin-top: 0.3em; }
    .wrote { margin-top: 0.3em; }
    .answers { padding-left: 0; }
    .answers > li { grid-template-columns: minmax(0, 1fr); }
    .what { grid-column: 1; grid-row: auto; }
  }
</style>
