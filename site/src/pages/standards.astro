---
import Base from "../layouts/Base.astro";
import standards from "../data/standards.json";
import { results } from "../lib/results";

const words: Record<string, string> = { tested: "Tested", partly: "Partly", gap: "Not tested", "not-applicable": "Does not apply" };
const hue: Record<string, string> = { tested: "status-ok", partly: "status-warn", gap: "status-bad", "not-applicable": "" };
const order = ["tested", "partly", "gap", "not-applicable"];
const queryCount = (item: { domains: string[]; techniques: string[] }) =>
  results.queries.filter((q) => item.domains.includes(q.domain) || item.techniques.includes(q.technique)).length;
---

<Base title="Against the standards" description="How termite's tests line up with OWASP, MITRE and CWE." current="docs">
  <h1>How this lines up with the published lists</h1>
  <p class="lead">
    This page lists every item in the published security lists and shows whether termite's
    tests cover it, so you can see what is tested and what is not.
  </p>
  <p>
    Tested means that termite's tests cover the item, Partly means that they cover part of it,
    Not tested means that they do not cover it, and Does not apply means that the item is not
    about shell commands. Requests is the number of test requests that match the item.
  </p>
  {standards.map((standard) => (
    <>
      <h2><a href={standard.url}>{standard.name}</a></h2>
      <p class="cover" role="img" aria-label={order.map((s) => `${words[s]}: ${standard.items.filter((i) => i.status === s).length}`).join(", ")}>
        {order.map((status) => standard.items.filter((item) => item.status === status).map(() => <i class={status}></i>))}
      </p>
      <p class="note">{order.filter((s) => standard.items.some((i) => i.status === s)).map((s) => `${standard.items.filter((i) => i.status === s).length} ${words[s].toLowerCase()}`).join(", ")}</p>
      <div class="scroll">
        <table>
          <thead><tr><th scope="col">Item</th><th scope="col">Status</th><th scope="col" class="number">Requests</th><th scope="col">What covers it</th></tr></thead>
          <tbody>
            {standard.items.map((item) => (
              <tr>
                <th scope="row">{item.id} {item.name}</th>
                <td class={`status ${hue[item.status]}`}>{words[item.status]}</td>
                <td class="number">{queryCount(item) || ""}</td>
                <td>{item.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ))}
  <p class="note">The mapping is in <code>site/src/data/standards.json</code>.</p>
</Base>

<style>
  th[scope="row"] { font-weight: 500; color: var(--ink); min-width: 15em; }
  .cover { display: flex; gap: 3px; max-width: none; margin: 0.4em 0 0.2em; }
  .cover i { flex: 1; height: 16px; border-radius: 2px; }
  .tested { background: var(--good); }
  .partly { background: var(--gallery); }
  .gap { background: var(--critical); }
  .not-applicable { background: var(--line); }
</style>
