---
import { getCollection } from "astro:content";
import SetupPrompt from "../../components/SetupPrompt.astro";
import Base from "../../layouts/Base.astro";
import { page } from "../../lib/results";

const titles: Record<string, string> = {
  "getting-started": "Getting started",
  "plain-english": "In plain English",
  "using-termite": "Using termite",
  "safety-ladder": "The safety ladder",
  "red-team": "Red-teaming a model",
  agents: "Agent tools",
  evaluation: "How the testing works",
  tests: "The tests",
  failures: "Failure types",
  architecture: "How it is built",
  "termite-models": "termite's own models",
  "learning-to-train": "Train your own models",
};
const order = Object.keys(titles);

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
// Links between files in `docs/` become links between pages.
const html = (doc.rendered?.html ?? "").replace(/href="([\w-]+)\.md(#[^"]*)?"/g, 'href="../$1/$2"');
// On GitHub this is a link to the prompt; here it becomes the prompt itself.
const [before, after] = html.split('<p><a href="agent-setup-prompt.txt">Read the prompt</a></p>');
const docs = (await getCollection("docs")).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const title = titles[doc.id] ?? doc.id;
const sections = (doc.rendered?.metadata?.headings ?? []).filter((heading) => heading.depth === 2);
---

<Base title={title} description={`termite documentation: ${title}`} current="docs">
  <div class="docs">
    <nav aria-label="Documentation">
      {docs.map((item) => (
        <a href={page(`docs/${item.id}/`)} aria-current={item.id === doc.id ? "page" : undefined}>
          {titles[item.id] ?? item.id}
        </a>
      ))}
      <a href={page("standards/")}>Against the standards</a>
    </nav>
    <article>
      {sections.length > 3 && (
        <details class="sections" open>
          <summary>On this page</summary>
          {sections.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
        </details>
      )}
      <Fragment set:html={before} />
      {after !== undefined && <SetupPrompt />}
      <Fragment set:html={after} />
    </article>
  </div>
</Base>

<script>
  // The list stays open beside the text, and closed where it would push the text down.
  if (matchMedia("(max-width: 760px)").matches) {
    document.querySelector("details.sections")?.removeAttribute("open");
  }
</script>

<style>
  .docs { display: grid; grid-template-columns: 13em minmax(0, 1fr); gap: 2.4em; }
  nav { display: flex; flex-direction: column; gap: 0.5em; font-size: 0.95rem; position: sticky; top: 1em; align-self: start; }
  nav a { color: var(--ink-soft); text-decoration: none; }
  nav a[aria-current] { color: var(--ink); font-weight: 700; }
  article :global(h1) { font-size: 2.3rem; }
  article :global(table) { display: block; overflow-x: auto; }
  /* Prompts and messages are prose, so they wrap. Commands stay as typed. */
  article :global(pre[data-language="text"]) { white-space: pre-wrap; overflow-wrap: anywhere; }
  .sections { float: right; width: 15em; margin: 0.4em 0 1em 2em; padding: 0.7em 1em; background: var(--panel); border-radius: 4px; font-size: 0.92rem; line-height: 1.3; }
  .sections summary { cursor: pointer; color: var(--ink-soft); }
  .sections a { display: block; margin-top: 0.5em; }
  @media (max-width: 760px) {
    .docs { grid-template-columns: minmax(0, 1fr); gap: 1.2em; }
    nav { flex-direction: row; flex-wrap: wrap; position: static; }
    .sections { float: none; width: auto; margin: 0 0 1em; }
  }
</style>
